    <worksheet name='ADJUSTED TRANSACTION AMOUNTS (INFLATION)'>
      <table>
        <view>
          <datasources>
            <datasource caption='cc_data+' name='federated.1y0kkmi0rfet8b1237n2m0sauo06' />
          </datasources>
          <datasource-dependencies datasource='federated.1y0kkmi0rfet8b1237n2m0sauo06'>
            <column caption='INFLATION-ADJUSTED TRANSACTION AMOUNTS' datatype='real' name='[Calculation_2501421550387200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amt] * (1 + 0.02) ^ (YEAR(TODAY()) - YEAR([trans_date_trans_time]))' />
            </column>
            <column caption='Amt' datatype='real' name='[amt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2501421550387200]' derivation='Sum' name='[sum:Calculation_2501421550387200:qk]' pivot='key' type='quantitative' />
